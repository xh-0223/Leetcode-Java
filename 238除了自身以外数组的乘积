class Solution {
    public int[] productExceptSelf(int[] nums) {
        int n=nums.length;
        int [] answer=new int[n];
        int bsum=1;
        int asum=1;
        Arrays.fill(answer,1);
        for(int i=0,j=n-1;i<n;i++,j--){
            answer[i]*=bsum;
            answer[j]*=asum;
            bsum*=nums[i];
            asum*=nums[j];
           

    }
    return answer;
    }
}
