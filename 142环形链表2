public class Solution {
    public ListNode detectCycle(ListNode head) {

        // ListNode fast=head;
        // ListNode slow =head;
        // while(fast!=null&&fast.next!=null){
        //         slow=slow.next;
        //         fast=fast.next.next;
        //         if(slow==fast){
        //             slow=head;
        //             while(slow!=fast){
        //                 slow=slow.next;
        //                 fast=fast.next;
        //             }
        //             return slow;
        //         }
        // }

        // return null;

        Set<ListNode> x=new HashSet<>();
        ListNode pre=head;
        while(pre!=null){
            if(x.contains(pre)){
                    return pre;
            }else{
                x.add(pre);
            }
            pre=pre.next;
        }
        return null;
    }
}
