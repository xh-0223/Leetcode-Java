//Kadane算法
class Solution {
    public int maxSubArray(int[] nums) {
        int n=nums.length;
       int maxsum=nums[0];
        int current=0;
        for(int i =0;i<n;i++){
              current=Math.max(nums[i],nums[i]+current);
              maxsum=Math.max(maxsum,current);  
        }
        return maxsum;

    }
}



